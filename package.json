{
  "name": "global-tld-list",
  "version": "1.29.0",
  "description": "Every IANA top-level domain (TLD), refreshed daily: validate TLDs, get the TLD of a hostname, ccTLD country codes, brand TLDs, IDN/punycode forms, registry operators and RDAP servers. Zero dependencies, typed, ESM + CJS.",
  "keywords": [
    "brand-tld",
    "cctld",
    "country-code",
    "domain",
    "domain-validation",
    "domains",
    "gtld",
    "hostname",
    "iana",
    "icann",
    "idn",
    "punycode",
    "rdap",
    "tld",
    "tld-list",
    "tlds",
    "top-level-domain",
    "top-level-domains",
    "typescript"
  ],
  "homepage": "https://github.com/mastermunj/global-tld-list#readme",
  "bugs": {
    "url": "https://github.com/mastermunj/global-tld-list/issues"
  },
  "license": "MIT",
  "author": "Munjal Dhamecha",
  "repository": {
    "type": "git",
    "url": "https://github.com/mastermunj/global-tld-list.git"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./details": {
      "types": "./dist/types/details.d.ts",
      "import": "./dist/esm/details.js",
      "require": "./dist/cjs/details.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:pkgjson",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgjson": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "clean": "rimraf dist coverage",
    "commit": "git-cz",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "generate": "node scripts/generate.mts",
    "lint": "oxlint --type-aware .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:mock": "npm run release -- --dry-run",
    "test": "vitest",
    "test:watch": "npm run test -- --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mastermunj/oxc-config": "^0.0.7",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "commit-and-tag-version": "^13.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
